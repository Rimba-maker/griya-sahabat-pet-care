---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Griya Sahabat Pet Care — Pet Shop, Grooming, Hotel & Daycare",
  description = "Pet shop, grooming, hotel, dan daycare dalam satu tempat. Live CCTV 24 jam, zona terpisah kucing-anjing, paspor hewan tersimpan. Titipkan sahabatmu dengan tenang.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="pet shop, grooming kucing anjing, pet hotel, pet daycare, penitipan hewan live cctv, grooming hewan terpercaya" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.jpg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PetStore",
      "name": "Griya Sahabat Pet Care",
      "description": description,
      "additionalType": "https://schema.org/LocalBusiness",
      "makesOffer": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Grooming & Spa" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pet Hotel" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pet Daycare" } }
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
