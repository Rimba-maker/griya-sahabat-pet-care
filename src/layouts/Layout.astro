---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Griya Sahabat Pet Care — Pet Shop, Grooming, Hotel & Daycare",
  description = "Pet shop, grooming, hotel, dan daycare dalam satu tempat. Kenali Paspor Sahabat, zona kucing dan anjing terpisah, serta alur akses CCTV privat. Rencanakan kunjungan sahabatmu.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/dynapuff-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noto-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="pet shop, grooming kucing anjing, pet hotel, pet daycare, penitipan hewan live cctv, grooming hewan terpercaya" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Griya Sahabat Pet Care — rumah kedua untuk sahabatmu" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PetStore",
      "name": "Griya Sahabat Pet Care",
      "description": description,
      "additionalType": "https://schema.org/LocalBusiness",
      "makesOffer": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Grooming & Spa" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pet Hotel" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pet Daycare" } }
      ]
    })} />
  </head>
  <body>
    <a class="skip-link button" href="#main-content">Lewati ke isi utama</a>
    <slot />
  </body>
</html>
