---
import { PawPrintIcon } from "@phosphor-icons/react/dist/ssr/PawPrint";
import { ListIcon } from "@phosphor-icons/react/dist/ssr/List";
const links = [
  { label: "Layanan", href: "#layanan" },
  { label: "Grooming", href: "#grooming" },
  { label: "Pet Hotel", href: "#hotel" },
  { label: "Daycare", href: "#daycare" },
  { label: "Toko", href: "#toko" },
  { label: "Akses CCTV", href: "#live-cctv" },
];
---
<header class="site-header">
  <nav class="wrap header-row" aria-label="Navigasi utama">
    <a href="#hero" class="brand" aria-label="Griya Sahabat Pet Care, beranda">
      <PawPrintIcon size={28} weight="fill" aria-hidden="true" />
      <span><span class="brand-name">Griya Sahabat</span><small>PET CARE</small></span>
    </a>
    <ul class="desktop-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <a href="#booking" class="button-secondary header-booking">Yuk, rencanakan kunjungan</a>
    <details class="mobile-menu" id="menu-nav">
      <summary aria-label="Menu navigasi"><ListIcon size={25} weight="bold" aria-hidden="true" /></summary>
      <ul class="mobile-links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><a href="#paspor">Paspor Sahabat</a></li>
        <li><a href="#booking">Rencanakan kunjungan</a></li>
      </ul>
    </details>
  </nav>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>("#menu-nav");
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) menu.open = false;
  });
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
